# Copy to .env for `pnpm dev` (the defaults below match compose.dev.yml).
DATABASE_URL=postgres://goblin:goblin@localhost:5433/goblin
PORT=8787
# Where the PWA runs (links in emails point here)
APP_URL=http://localhost:3000
# true only behind Caddy (the visitor's address then comes from X-Forwarded-For)
TRUST_PROXY=false
# Web Push for phones: `pnpm --filter @goblincamp/server vapid` prints a pair (without them phones get no reminders)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
