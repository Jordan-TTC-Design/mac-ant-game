# 複製成 .env（不進 git）再改。docker compose 會讀 repo 最上層的 .env。

COMPOSE_PROJECT_NAME=goblincamp

# 對外的網址（手機網頁與 API 都在這裡；信裡的連結指向這裡；手機的登入 cookie 只接受這個來源）
APP_URL=https://goblin.example.com
# web 容器對主機開的 port（主機上的反向代理轉到這裡）
WEB_PORT=3898

# 資料庫密碼：只用英文字母與數字（它會放進連線網址）
POSTGRES_PASSWORD=change-me-letters-and-digits

# 手機推播（Web Push）：make vapid 產生一組，貼在這裡。沒填的話手機收不到提醒，其他照常。
# 換金鑰之後，每支手機都要到設定頁重新「開啟通知」。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 寄信（Resend）。沒填的話信不會寄出，而是印在 make logs 裡（測試時可以從那裡拿確認連結）。
RESEND_API_KEY=
MAIL_FROM=哥布林營地 <noreply@example.com>
# 誰能開手機網頁的「後台」（產生邀請碼、看帳號與大世界）：信箱，多個用逗號分開；空白 = 沒有人
ADMIN_EMAILS=
